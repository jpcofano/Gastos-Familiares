rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function authDoc()    { return get(/databases/$(database)/documents/autorizados/$(request.auth.token.email.lower())); }
    function esAdmin() {
      let d = authDoc();
      return isSignedIn() && request.auth.token.email_verified == true && d != null && d.data.rol == 'admin';
    }
    function esMiembro() {
      let d = authDoc();
      return isSignedIn() && request.auth.token.email_verified == true && d != null && d.data.memberId != null;
    }
    function miMemberId() {
      let d = authDoc();
      return d != null ? d.data.memberId : null;
    }
    // Dueño: admin cuyo email es jpcofano@gmail.com.
    // Se usa request.auth.token.email.lower() igual que authDoc() para consistencia.
    function esDueno() {
      return esAdmin() && request.auth.token.email.lower() == 'jpcofano@gmail.com';
    }

    // config/familia: legible por cualquier signed-in (necesario para bootstrap)
    match /config/{doc} {
      allow read:  if isSignedIn();
      allow write: if false;
    }

    // Catálogos de solo lectura — solo miembros resueltos
    match /tcDiario/{id} {
      allow read:  if esMiembro();
      allow write: if false;
    }
    match /subcategorias/{id} {
      allow read:  if esMiembro();
      allow write: if false;
    }
    match /etiquetas/{id} {
      allow read:  if esMiembro();
      allow write: if false;
    }

    // Whitelist de acceso — sembrado, inmutable desde el cliente
    match /autorizados/{email} {
      allow read:  if isSignedIn() && request.auth.token.email_verified == true;
      allow write: if false;
    }

    // Movimientos — lectura scoped, create validado campo a campo, update/delete cerrado
    match /movimientos/{id} {
      allow read: if esAdmin() || (esMiembro() && resource.data.persona == miMemberId());
      allow create: if esMiembro()
        && request.resource.data.creadoPor == miMemberId()
        && (esAdmin() || request.resource.data.persona == miMemberId())
        && request.resource.data.tipo in ['Gasto', 'Ingreso']
        && request.resource.data.moneda in ['ARS', 'USD']
        && request.resource.data.monto is number
        && request.resource.data.monto > 0
        && request.resource.data.fecha is timestamp
        && request.resource.data.mes is string
        && request.resource.data.mes.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.creadoEn == request.time
        && request.resource.data.actualizadoEn == request.time
        && request.resource.data.descripcion is string
        && request.resource.data.descripcion.size() > 0;
      allow update: if esAdmin()
        && request.resource.data.creadoPor == resource.data.creadoPor
        && request.resource.data.creadoEn == resource.data.creadoEn
        && request.resource.data.actualizadoEn == request.time;
      allow delete: if false;
    }

    // Solo admins
    match /resumenesTarjeta/{id} {
      allow read, write: if esAdmin();
    }
    match /itemsEsperados/{id} {
      allow read: if esMiembro();
      allow create, update: if esAdmin()
        && request.resource.data.tipo in ['Gasto', 'Ingreso']
        && request.resource.data.moneda in ['ARS', 'USD']
        && request.resource.data.activo is bool
        && request.resource.data.periodicidad in ['mensual', 'bimestral', 'trimestral', 'anual', 'unico']
        && request.resource.data.pagoAutomatico is bool;
      allow delete: if esAdmin();
    }
    match /reglasNormalizacion/{id} {
      allow read:  if esMiembro();
      allow write: if false;
    }

    // Comprobantes — subida por cualquier miembro, update/delete solo admin
    match /comprobantes/{hash} {
      allow read:   if esAdmin() || (esMiembro() && resource.data.subidoPor == miMemberId());
      allow create: if esMiembro();
      allow update, delete: if esAdmin();
    }

    // Entrantes — punto de entrada único para subida de archivos
    match /entrantes/{hash} {
      allow read:   if esMiembro() && (esAdmin() || resource == null || resource.data.creadoPor == miMemberId());
      allow create: if esMiembro()
        && request.resource.data.creadoPor == miMemberId()
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.hash is string;
      allow update, delete: if false;   // solo el router (admin SDK) escribe estado/destino
    }

    // Diccionario — lectura por todos los miembros (clasificador client-side); escritura admin + manual
    match /diccionario/{id} {
      allow read: if esMiembro();
      allow create, update: if esAdmin() || (esMiembro() && request.resource.data.origen == 'Manual');
      allow delete: if esAdmin();
    }

    // Destinos — solo lectura admin; toda escritura vía callable (Admin SDK, bypassa rules)
    match /destinos/{id} {
      allow read:  if esAdmin();
      allow write: if false;
    }

    // Patrimonio — aislado, solo dueño (jpcofano@gmail.com)
    match /flujosPatrimonio/{id} {
      allow read, write: if esDueno();
    }
    match /decisionesPatrimonio/{id} {
      allow read, write: if esDueno();
    }
    match /agendaMacro/{id} {
      allow read, write: if esDueno();
    }
    match /posicionesPatrimonio/{id} {
      allow read, write: if esDueno();
    }
    match /snapshotsPortafolio/{id} {
      allow read, write: if esDueno();
    }
    match /activosFijos/{id} {
      allow read, write: if esDueno();
    }
    match /posicionesManuales/{id} {
      allow read, write: if esDueno();
    }
    match /informesPortafolio/{id} {
      allow read, write: if esDueno();
    }
    match /analisisPosiciones/{ticker} {
      allow read, write: if esDueno();
    }
    // F9.141 — las escribe el cron actualizarPreciosDiarios vía Admin SDK (que se saltea
    // las Rules); el cliente solo las lee.
    match /preciosDiarios/{ticker} {
      allow read: if esDueno();
      allow write: if false;
    }
    match /indicadoresPosicion/{ticker} {
      allow read: if esDueno();
      allow write: if false;
    }
    match /analisisSectorial/{id} {
      allow read, write: if esDueno();
    }
    match /configPatrimonio/{id} {
      allow read, write: if esDueno();
    }
    match /cafciCarteras/{id} {
      allow read, write: if esDueno();
    }
    match /cafciMapping/{id} {
      allow read, write: if esDueno();
    }
    // F9.127 — override de factor de riesgo por ticker. Mismo alcance que cafciMapping: es
    // configuración de análisis del dueño, no dato familiar compartido.
    match /factoresTicker/{ticker} {
      allow read, write: if esDueno();
    }
    // F9.130 — tipo de custodia declarado por cuenta/plataforma. Mismo alcance.
    match /custodiaCuenta/{cuenta} {
      allow read, write: if esDueno();
    }
    // F9.131 — declaraciones de exposición. La `nota` obligatoria se valida también acá: es una
    // regla del dominio, no del formulario, y sin ella una declaración no se distingue de haber
    // silenciado la alerta con un botón.
    match /declaraciones/{id} {
      allow read: if esDueno();
      allow write: if esDueno()
        && request.resource.data.nota is string
        && request.resource.data.nota.size() >= 20
        && request.resource.data.techoPct is number
        && request.resource.data.techoPct > 0
        && request.resource.data.techoPct <= 1
        && request.resource.data.eje in ['ticker', 'factor', 'bloque', 'contraparte']
        && request.resource.data.base in ['invertible', 'bloque'];
      allow delete: if esDueno();
    }
    match /seriesPrecios/{simbolo} {
      allow read, write: if esDueno();
    }
    match /optimizacionPortafolio/{id} {
      allow read, write: if esDueno();
    }
  }
}
